#include <stdio.h>      // printf, perror, fprintf
#include <stdlib.h>     // EXIT_FAILURE, atoi 
#include <string.h>     // memset 
#include <errno.h>      // errno, EINTR 
#include <unistd.h>     // close 
#include <signal.h>     // sigaction, sigset_t, sigprocmask, sig_atomic_t 
#include <sys/socket.h> // socket, bind, listen, accept, recv, setsockopt 
#include <sys/select.h> // pselect, fd_set, FD_
#include <netinet/in.h> // sockaddr_in, htonl, htons, INADDR_ANY 
#include <arpa/inet.h>  // inet_ntoa 

// флаг и обработчик сигнала
static volatile sig_atomic_t was_sighup = 0;

static void sighup_handler(int signal_number)
{   
    was_sighup = 1;
}

int main(int argc, char **argv)
{
    // один аргумент — номер порта, не 1 — подсказка и выход, вне диапазона — выход
    if (argc != 2)
    {
        fprintf(stderr, "usage: %s <port>\n", argv[0]);
        return EXIT_FAILURE;
    }
    int port = atoi(argv[1]);
    if (port <= 0 || port > 65535)
    {
        fprintf(stderr, "invalid port\n");
        return EXIT_FAILURE;
    }

    // создаём TCP-сокет
    int server_fd = socket(AF_INET, SOCK_STREAM, 0);
    if (server_fd == -1) 
    {
        perror("socket");
        return EXIT_FAILURE;
    }

    // разрешаем повторное использование адреса
    int opt = 1;
    if (setsockopt(server_fd, SOL_SOCKET, SO_REUSEADDR, &opt, sizeof(opt)) == -1) 
    {
        perror("setsockopt");
        close(server_fd);
        return EXIT_FAILURE;
    }

    struct sockaddr_in address; 
    memset(&address, 0, sizeof(address)); // обнуляем структуру
    address.sin_family = AF_INET; // IPv4
    address.sin_addr.s_addr = htonl(INADDR_ANY); // слушать на всех интерфейсах
    address.sin_port = htons(port); // порт в сетевом порядке байтов

    if (bind(server_fd, (struct sockaddr *)&address, sizeof(address)) == -1)
    {
        perror("bind");
        close(server_fd);
        return EXIT_FAILURE;
    }

    // переводим сокет в слушающий режим
    if (listen(server_fd, 16) == -1)
    {
        perror("listen");
        close(server_fd);
        return EXIT_FAILURE;
    }

    // установка обработчика
    struct sigaction action;
    memset(&action, 0, sizeof(action));
    action.sa_handler = sighup_handler;
    sigemptyset(&action.sa_mask);
    action.sa_flags = 0;
    if (sigaction(SIGHUP, &action, NULL) == -1)
    {
        perror("sigaction");
        close(server_fd);
        return EXIT_FAILURE;
    }

    // блокировка сигнала
    sigset_t blocked_mask;
    sigset_t original_mask;
    sigemptyset(&blocked_mask);
    sigaddset(&blocked_mask, SIGHUP);
    if (sigprocmask(SIG_BLOCK, &blocked_mask, &original_mask) == -1)
    {
        perror("sigprocmask");
        close(server_fd);
        return EXIT_FAILURE;
    }

    int client_fd = -1; // сейчас никого нет
    int running   = 1; // флаг для продолжения цикла

    while (running)
    {
        // server_fd — когда появится новый гость
        // client_fd — когда у него появятся данные
        // max_fd — наибольший номер дескриптора
        fd_set read_fds;
        FD_ZERO(&read_fds);
        FD_SET(server_fd, &read_fds);

        int max_fd = server_fd;
        if (client_fd != -1)
        {
            FD_SET(client_fd, &read_fds);
            if (client_fd > max_fd)
            {
                max_fd = client_fd;
            }
        }

        // сброс флага и вызов pselect
        was_sighup = 0;

        sigset_t wait_mask = original_mask;

        // max_fd + 1 — до какого бита просматривать
        // &read_fds — ждём готовность к чтению
        // NULL, NULL, NULL — запись и исключения не интересуют, без таймаута, ждать бесконечно
        // &wait_mask — маска сигналов на время ожидания
        int ready = pselect(max_fd + 1, &read_fds, NULL, NULL, NULL,  &wait_mask);

        // разбор результата
        if (ready == -1)
        {
            if (errno == EINTR)
            {
                if (was_sighup)
                {
                    printf("SIGHUP received\n");
                    fflush(stdout);
                }
                continue;
            }
            perror("pselect");
            break;
        }

        // проверка флага после успешного возврата
        if (was_sighup)
        {
            printf("SIGHUP received\n");
            fflush(stdout);
            was_sighup = 0;
        }

        if (FD_ISSET(server_fd, &read_fds))
        {
            struct sockaddr_in client_addr;
            socklen_t client_len = sizeof(client_addr);
            int new_fd = accept(server_fd, (struct sockaddr *)&client_addr, &client_len);
            if (new_fd == -1)
            {
                if (errno != EINTR) 
                perror("accept");
            } 
            else 
            {
                printf("New connection from %s:%d (fd=%d)\n", inet_ntoa(client_addr.sin_addr), ntohs(client_addr.sin_port), new_fd);
                fflush(stdout);

                // если удерживаемого ещё нет — берём нового
                if (client_fd == -1)
                {
                    client_fd = new_fd;
                    printf("Keeping connection fd=%d\n", client_fd);
                } 
                // если уже есть — сразу закрываем нового
                else 
                {
                    printf("Rejecting fd=%d (already have fd=%d)\n", new_fd, client_fd);
                    close(new_fd);
                }
                fflush(stdout);
            }
        }

        // чтение данных
        if (client_fd != -1 && FD_ISSET(client_fd, &read_fds))
        {
            char buffer[4096];
            ssize_t received = recv(client_fd, buffer, sizeof(buffer), 0);

            if (received > 0)
            {
                printf("Received %zd bytes from fd=%d\n", received, client_fd);
                fflush(stdout);
            } 
            else if (received == 0) 
            {
                printf("Client fd=%d closed connection\n", client_fd);
                fflush(stdout);
                close(client_fd);
                client_fd = -1;
            } 
            else 
            {
                if (errno == EINTR) 
                {
                    // прервано сигналом — повторим
                } 
                else 
                {
                    perror("recv");
                    close(client_fd);
                    client_fd = -1;
                }
            }
        }
    }

    // освобождение ресурсов
    if (client_fd != -1) 
    {
        close(client_fd);
    }
    close(server_fd);

    if (sigprocmask(SIG_SETMASK, &original_mask, NULL) == -1)
    {
        perror("sigprocmask (restore)");
        return EXIT_FAILURE;
    }

    return EXIT_SUCCESS;
}
